# Get your token from https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Get your API key from https://aistudio.google.com/app/apikey
API_GEMINI_TOKEN=
# Optional: select a model available to your Gemini account.
GEMINI_MODEL=

# Optional: hosted PostgreSQL (Neon or another provider). Empty uses local SQLite.
DATABASE_URL=
# Direct connection for the one-time SQLite import; do not use the pooler URL.
DATABASE_URL_UNPOOLED=
# Optional: override the local SQLite file path.
SINYALX_DB_PATH=
SINYALX_UI_URL=http://127.0.0.1:3000
# Set this on Vercel to the public Python backend URL.
SINYALX_API_URL=http://127.0.0.1:8765
